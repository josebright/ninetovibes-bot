# ---- Copy this file to .env and fill in the values ----

# --- Pexels (free, sign up at https://www.pexels.com/api/) ---
PEXELS_API_KEY=

# --- Pixabay (free, sign up at https://pixabay.com/api/docs/) ---
PIXABAY_API_KEY=

# --- YouTube Data API v3 (free; OAuth flow, see scripts/setup_youtube_oauth.md) ---
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
YOUTUBE_CHANNEL_HANDLE=@ninetovibes
# Separate API key (read-only) for trending search; optional but recommended.
# In the same Google Cloud project → Credentials → Create Credentials → API key.
YOUTUBE_API_KEY=

# --- Telegram bot (free; message @BotFather to create, see scripts/setup_telegram_bot.md) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ollama (local, no key needed) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# --- Review webhook server ---
REVIEW_SERVER_HOST=127.0.0.1
REVIEW_SERVER_PORT=8765

# --- Optional: Semantic Scholar (free, higher rate limit with key) ---
SEMANTIC_SCHOLAR_API_KEY=
